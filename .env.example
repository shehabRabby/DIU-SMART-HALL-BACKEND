# ==============================================================================
# SERVER & ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000

# API Base URL (Include /api/v1 for payment gateway callbacks like bKash)
BACKEND_URL=http://localhost:5000/api/v1

# Allowed CORS origin for the Next.js / React frontend client
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# DATABASE (PostgreSQL via Prisma)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diu_smarthall?schema=public"

# ==============================================================================
# AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Dedicated HMAC-SHA256 Signing Secret for Tamper-Proof Canteen QR Meal Slips
CANTEEN_QR_SECRET=your_canteen_qr_hmac_signing_secret_2026

# ==============================================================================
# EMAIL / SMTP CONFIGURATION (Digital Meal Slip & Notifications)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_canteen_sender_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# ==============================================================================
# PAYMENT GATEWAYS (DIU SmartHall Canteen)
# ==============================================================================
# 1. Stripe Checkout & Webhook
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# 2. bKash Tokenized Checkout (Sandbox / Live)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# 3. Nagad Payment Gateway (Optional / Ready when merchant credentials arrive)
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=

# 4. Rocket Payment Gateway (Optional / Ready when merchant credentials arrive)
ROCKET_MERCHANT_ID=
ROCKET_SECRET_KEY=