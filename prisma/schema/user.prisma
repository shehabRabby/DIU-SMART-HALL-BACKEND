model User {
  id                 String       @id @default(uuid())
  name               String
  email              String
  password           String?
  googleId           String?      @unique
  authProvider       AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean      @default(false)
  role               Role         @default(STUDENT)
  status             UserStatus   @default(ACTIVE)
  needPasswordChange Boolean      @default(false)
  imageUrl           String       @default("")
  imagePublicId      String       @default("")
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  student              Student?
  reviewedApplications SeatApplication[]   @relation("ReviewedSeatApplications")
  reviewedRoomChanges  RoomChangeRequest[] @relation("ReviewedRoomChanges")
  issuedWarnings       StudentWarning[]    @relation("IssuedStudentWarnings")
  revokedWarnings      StudentWarning[]    @relation("RevokedStudentWarnings")

  @@unique([email])
  @@map("users")
}
