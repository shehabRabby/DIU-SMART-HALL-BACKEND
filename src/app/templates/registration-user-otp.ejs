
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verification - DIU Smart Hall System</title>
</head>

<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:Arial,Helvetica,sans-serif; color:#1e293b;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:35px 12px;">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" border="0"
          style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background:#12366b; padding:28px 20px;">
              <h1 style="margin:0; color:#ffffff; font-size:25px;">
                DIU Smart Hall System
              </h1>
              <p style="margin:8px 0 0; color:#bfdbfe; font-size:13px;">
                Daffodil International University
              </p>
            </td>
          </tr>

          <!-- Verification Banner -->
          <tr>
            <td align="center" style="background:#eff6ff; padding:35px 25px 30px;">
              <div style="display:inline-block; width:65px; height:65px; line-height:65px; border-radius:50%; background:#dbeafe; color:#2563eb; font-size:32px;">
                &#9993;
              </div>

              <h1 style="font-size:27px; color:#12366b; margin:18px 0 10px;">
                Verify Your Email
              </h1>

              <p style="font-size:14px; color:#64748b; margin:0; line-height:1.7;">
                One more step to get started with your smart hall experience.
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:30px 35px 10px;">
              <h2 style="font-size:20px; color:#12366b; margin:0 0 15px;">
                Hello <%= name %>!
              </h2>

              <p style="font-size:15px; line-height:1.8; color:#475569; margin:0 0 15px;">
                Welcome to <strong>DIU Smart Hall System!</strong>
                We're excited to have you on board.
              </p>

              <p style="font-size:15px; line-height:1.8; color:#475569; margin:0;">
                We received a request to verify your email address:
              </p>

              <p style="font-size:14px; font-weight:bold; color:#2563eb; text-align:center; margin:15px 0 5px; word-break:break-word;">
                <%= email %>
              </p>

              <p style="font-size:14px; line-height:1.7; color:#64748b; text-align:center; margin:15px 0 5px;">
                Use the verification code below to complete your registration.
              </p>
            </td>
          </tr>

          <!-- OTP Box -->
          <tr>
            <td align="center" style="padding:20px 25px 25px;">
              <div style="background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; padding:22px 15px; max-width:350px;">
                <p style="font-size:12px; color:#64748b; font-weight:bold; letter-spacing:2px; margin:0 0 12px;">
                  YOUR VERIFICATION CODE
                </p>

                <div style="font-size:32px; font-weight:bold; color:#1d4ed8; letter-spacing:10px; padding-left:10px;">
                  <%= otp %>
                </div>
              </div>

              <p style="font-size:13px; color:#64748b; margin:18px 0 0; line-height:1.7;">
                This code will expire in
                <strong style="color:#12366b;"><%= expirationMinutes %> minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td style="padding:5px 35px 30px;">
              <div style="background:#fff7ed; border-left:4px solid #f59e0b; border-radius:8px; padding:18px;">
                <h3 style="font-size:15px; color:#9a3412; margin:0 0 8px;">
                  &#9888; Security Notice
                </h3>

                <p style="font-size:13px; color:#7c2d12; line-height:1.7; margin:0;">
                  Never share this verification code with anyone.
                  If you did not request email verification,
                  you can safely ignore this email.
                </p>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background:#12366b; padding:25px 20px;">
              <h3 style="color:#ffffff; font-size:16px; margin:0 0 8px;">
                DIU Smart Hall System
              </h3>

              <p style="color:#bfdbfe; font-size:12px; margin:0 0 12px;">
                Daffodil International University
              </p>

              <div style="height:1px; background:#355785; margin:15px 0;"></div>

              <p style="color:#cbd5e1; font-size:11px; line-height:1.6; margin:0;">
                Better Living, Smarter Campus<br />
                &copy; 2026 DIU Smart Hall System. All rights reserved.
              </p>

              <p style="color:#94a3b8; font-size:10px; margin:12px 0 0;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>