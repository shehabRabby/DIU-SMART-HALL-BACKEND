<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= subject %></title>
</head>
<body style="background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 32px 16px; color: #0f172a;">
  <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
    
    <!-- Header -->
    <div style="background-color: #15803d; padding: 24px 32px; color: #ffffff;">
      <p style="margin: 0; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #dcfce7;">
        DIU SmartHall Security &amp; Gate Control
      </p>
      <h1 style="margin: 6px 0 0; font-size: 20px; font-weight: 700; letter-spacing: -0.01em;">
        Approved Digital Gate Pass
      </h1>
    </div>

    <!-- Body Content -->
    <div style="padding: 32px;">
      <!-- Status Badge -->
      <span style="display: inline-block; padding: 4px 12px; border-radius: 9999px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; background-color: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0;">
        APPROVED • ONE-TIME VERIFIABLE
      </span>

      <p style="margin: 20px 0 16px; font-size: 15px; color: #334155;">
        Dear <strong style="color: #0f172a;"><%= studentName %></strong> <span style="color: #64748b;">(ID: <%= studentUniId %>)</span>, your gate pass request has been approved. Present the QR code or Pass Code below to the hall security guard at the main gate.
      </p>

      <!-- QR Code & Pass Code Box -->
      <div style="background-color: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 24px; text-align: center; margin-bottom: 24px;">
        <img src="<%= qrImageUrl %>" alt="Gate Pass QR Code" width="190" height="190" style="border: 4px solid #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);" />
        <div style="margin-top: 14px;">
          <span style="display: inline-block; background-color: #dcfce7; color: #15803d; font-weight: 700; font-size: 16px; padding: 6px 18px; border-radius: 6px; letter-spacing: 1px;">
            <%= passCode %>
          </span>
        </div>
        <p style="margin: 8px 0 0; font-size: 12px; color: #64748b;">
          Scan QR or verify Pass Code at gate
        </p>
      </div>

      <!-- Details Card -->
      <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
          <tr>
            <td style="padding: 6px 0; color: #64748b; width: 42%;">Hall Residence</td>
            <td style="padding: 6px 0; font-weight: 600; color: #0f172a;"><%= hallName %> (<%= hallShortName %>)</td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Allocated Room</td>
            <td style="padding: 6px 0; font-weight: 600; color: #0f172a;"><%= roomInfo %></td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Pass Category</td>
            <td style="padding: 6px 0; font-weight: 600; color: #0f172a;"><%= passType.replace(/_/g, ' ') %></td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Destination</td>
            <td style="padding: 6px 0; font-weight: 600; color: #0f172a;"><%= destination %></td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Purpose / Reason</td>
            <td style="padding: 6px 0; color: #334155;"><%= reason %></td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Departure Time</td>
            <td style="padding: 6px 0; font-weight: 600; color: #0369a1;"><%= departureAt %></td>
          </tr>
          <tr>
            <td style="padding: 6px 0; color: #64748b;">Expected Return</td>
            <td style="padding: 6px 0; font-weight: 700; color: #b91c1c;"><%= expectedReturnAt %></td>
          </tr>
          <% if (adminNote) { %>
            <tr>
              <td style="padding: 6px 0; color: #64748b;">Admin Note</td>
              <td style="padding: 6px 0; font-style: italic; color: #334155;"><%= adminNote %></td>
            </tr>
          <% } %>
        </table>
      </div>

      <!-- Policy Note -->
      <div style="border-top: 1px solid #e2e8f0; padding-top: 16px; font-size: 13px; line-height: 1.5; color: #64748b;">
        <strong style="color: #475569;">Security Notice:</strong> This QR pass is strictly single-use and automatically expires upon hall re-entry or after the expected return deadline. Late return without prior approval may trigger disciplinary action.
      </div>
    </div>

    <!-- Footer -->
    <div style="background-color: #f1f5f9; padding: 16px 32px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0;">
      &copy; <%= new Date().getFullYear() %> DIU SmartHall Management System. Automated Security Pass.
    </div>
  </div>
</body>
</html>