
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset Successful</title>
</head>

<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:Arial,Helvetica,sans-serif; color:#1e293b;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="padding:35px 12px;">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0" border="0"
          style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background:#12366b; padding:28px 20px;">
              <h1 style="margin:0; color:#ffffff; font-size:25px;">
                DIU Smart Hall System
              </h1>
              <p style="margin:8px 0 0; color:#bfdbfe; font-size:13px;">
                Daffodil International University
              </p>
            </td>
          </tr>

          <!-- Success Banner -->
          <tr>
            <td align="center" style="background:#f0fdf4; padding:35px 25px;">
              <div style="display:inline-block; width:65px; height:65px; line-height:65px; border-radius:50%; background:#dcfce7; color:#16a34a; font-size:38px; font-weight:bold;">
                &#10003;
              </div>

              <h1 style="font-size:27px; color:#166534; margin:20px 0 10px;">
                Password Reset Successful!
              </h1>

              <p style="font-size:14px; color:#64748b; margin:0; line-height:1.7;">
                Your account security has been updated successfully.
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:30px 35px 15px;">
              <h2 style="font-size:20px; color:#12366b; margin:0 0 15px;">
                Hello <%= name %>!
              </h2>

              <p style="font-size:15px; line-height:1.8; color:#475569; margin:0 0 15px;">
                Your password has been changed successfully.
                You can now log in to your
                <strong>DIU Smart Hall System</strong>
                account using your new password.
              </p>

              <p style="font-size:15px; line-height:1.8; color:#475569; margin:0;">
                Your account is ready to use. You can securely
                access your dashboard and continue enjoying
                our hall management services.
              </p>
            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td style="padding:20px 35px 25px;">
              <div style="background:#fff7ed; border-left:4px solid #f59e0b; border-radius:8px; padding:18px;">
                <h3 style="font-size:16px; color:#9a3412; margin:0 0 8px;">
                  &#9888; Security Notice
                </h3>
                <p style="font-size:13px; color:#7c2d12; line-height:1.7; margin:0;">
                  If you did not make this change, please contact
                  your hall authority or support team immediately
                  to protect your account.
                </p>
              </div>
            </td>
          </tr>

          <!-- Login Button -->
          <tr>
            <td align="center" style="padding:5px 25px 30px;">
              <a href="https://your-frontend-url.com/login"
                style="display:inline-block; background:#2563eb; color:#ffffff; text-decoration:none; font-size:15px; font-weight:bold; padding:15px 35px; border-radius:8px;">
                Log In to Your Account &rarr;
              </a>

              <p style="font-size:13px; color:#94a3b8; margin:20px 0 0;">
                Thank you for using DIU Smart Hall System!
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background:#12366b; padding:25px 20px;">
              <h3 style="color:#ffffff; font-size:16px; margin:0 0 8px;">
                DIU Smart Hall System
              </h3>

              <p style="color:#bfdbfe; font-size:12px; margin:0 0 12px;">
                Daffodil International University
              </p>

              <div style="height:1px; background:#355785; margin:15px 0;"></div>

              <p style="color:#cbd5e1; font-size:11px; line-height:1.6; margin:0;">
                Better Living, Smarter Campus<br />
                &copy; 2026 DIU Smart Hall System. All rights reserved.
              </p>

              <p style="color:#94a3b8; font-size:10px; margin:12px 0 0;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>