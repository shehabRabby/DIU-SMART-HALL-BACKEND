<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1e293b;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
      }

      .container {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        padding: 35px 25px;
        text-align: center;
        color: #ffffff;
      }

      .logo {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        background-color: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 14px;
        line-height: 58px;
        font-size: 20px;
        font-weight: bold;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
      }

      .header p {
        margin: 8px 0 0;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
      }

      /* Content */
      .content {
        padding: 35px;
      }

      .greeting {
        margin: 0 0 12px;
        font-size: 18px;
        font-weight: 600;
        color: #111827;
      }

      .message {
        margin: 0;
        font-size: 14px;
        line-height: 1.7;
        color: #64748b;
      }

      /* OTP Box */
      .otp-container {
        margin: 28px 0;
        padding: 25px 20px;
        background-color: #f8faff;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        text-align: center;
      }

      .otp-title {
        margin: 0 0 12px;
        font-size: 11px;
        font-weight: bold;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }

      .otp {
        display: inline-block;
        padding: 14px 22px;
        background-color: #ffffff;
        border: 1px solid #bfdbfe;
        border-radius: 9px;
        color: #2563eb;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 8px;
      }

      .expiry {
        margin: 14px 0 0;
        font-size: 12px;
        color: #64748b;
      }

      .expiry strong {
        color: #334155;
      }

      /* Security Message */
      .notice {
        margin-top: 22px;
        padding: 15px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 7px;
      }

      .notice p {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9a3412;
      }

      /* Footer */
      .footer {
        padding: 22px 25px;
        background-color: #f8fafc;
        border-top: 1px solid #eef2f7;
        text-align: center;
      }

      .footer-title {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
      }

      .footer-text {
        margin: 0;
        font-size: 11px;
        line-height: 1.6;
        color: #94a3b8;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 28px 20px;
        }

        .header {
          padding: 30px 20px;
        }

        .header h1 {
          font-size: 21px;
        }

        .otp {
          font-size: 25px;
          letter-spacing: 6px;
          padding: 13px 18px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">SH</div>

          <h1>Password Reset Request</h1>

          <p>DIU SMART HALL SYSTEM</p>
        </div>

        <!-- Content -->
        <div class="content">

          <p class="greeting">
            Hello <%= name %>,
          </p>

          <p class="message">
            We received a request to reset your password.
            Use the OTP below to reset your password.
          </p>

          <!-- OTP -->
          <div class="otp-container">
            <p class="otp-title">
              Your OTP Code
            </p>

            <div class="otp">
              <%= otp %>
            </div>

            <p class="expiry">
              This OTP will expire in
              <strong><%= expirationMinutes %> minutes</strong>.
            </p>
          </div>

          <!-- Security Notice -->
          <div class="notice">
            <p>
              <strong>Security Notice:</strong>
              If you did not request a password reset, please ignore this
              email. Never share your OTP with anyone.
            </p>
          </div>

        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-title">
            DIU SMART HALL SYSTEM
          </p>

          <p class="footer-text">
            This is an automated email. Please do not reply to this message.
            <br />
            &copy; DIU SMART HALL SYSTEM. All rights reserved.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
